@page "/"
@implements IAsyncDisposable
@inject ChatSessionClient Client
@inject IJSRuntime Js

@if (_navOpen)
{
    <div class="nav-backdrop" @onclick="() => _navOpen = false"></div>
}

<div class="shell @(_navOpen ? "nav-open" : "") @(_activityOpen ? "activity-open" : "")">
    <SessionList WorkingDirectory="@_workingDirectory"
                 Running="Client.IsRunning"
                 Busy="@(Client.IsSwitchingSession || Client.IsInitializing)"
                 Loading="Client.IsInitializing"
                 Sessions="Client.Sessions"
                 OnSwitch="SwitchSessionAsync"
                 OnNew="NewSessionAsync"
                 OnClose="() => Client.CloseCurrentAsync()" />

    <main class="main">
        <header class="context">
            <div class="context-left">
                <button type="button" class="context-toggle nav-toggle" title="会话列表" @onclick="ToggleNav">
                    <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M3 5h14M3 10h14M3 15h14"/></svg>
                </button>
                <div class="title">OneCode</div>
            </div>
            <div class="meta nums">
                <span class="mode">@Client.Mode</span>
                @if (Client.IsRunning)
                {
                    <span class="running">运行中</span>
                }
                <span>@Client.InputTokens / @Client.OutputTokens tok</span>
            </div>
            <button type="button" class="context-toggle theme-toggle" title="切换主题" @onclick="ToggleThemeAsync">
                @if (_theme == "dark")
                {
                    <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="10" cy="10" r="3.4"/><path d="M10 2.5v2M10 15.5v2M2.5 10h2M15.5 10h2M4.7 4.7l1.4 1.4M13.9 13.9l1.4 1.4M15.3 4.7l-1.4 1.4M6.1 13.9l-1.4 1.4"/></svg>
                }
                else
                {
                    <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14.8 12.6a5.6 5.6 0 0 1-7.4-7.4 5.6 5.6 0 1 0 7.4 7.4z"/></svg>
                }
            </button>
            <button type="button" class="context-toggle activity-toggle" title="上下文面板" @onclick="ToggleActivity">
                <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><rect x="3" y="4" width="14" height="12" rx="2"/><path d="M13 4v12"/></svg>
            </button>
        </header>

        <div class="transcript @(Client.IsSwitchingSession || Client.IsInitializing ? "busy" : "")">
            @if (Client.Messages.Count == 0 && !Client.IsInitializing && !Client.IsSwitchingSession)
            {
                <div class="empty-hero">
                    <h1 class="hero-title">OneCode</h1>
                    <p class="hero-sub">输入消息开始对话；Enter 发送，Shift+Enter 换行</p>
                </div>
            }
            <MessageList Messages="Client.Messages" SessionKey="@Client.ForegroundSessionId" />

            @if (Client.IsSwitchingSession || Client.IsInitializing)
            {
                <div class="transcript-loading" role="status">
                    @(Client.IsInitializing ? "正在初始化会话…" : "正在加载会话…")
                </div>
            }

            @if (Client.ToolCalls.Count > 0)
            {
                <div class="tools">
                    @foreach (var call in Client.ToolCalls)
                    {
                        <ToolCallCard Call="call" />
                    }
                </div>
            }
        </div>

        @if (Client.Pending is { } pending)
        {
            <InteractionCard Pending="pending" OnRespond="RespondAsync" />
        }

        <footer class="composer">
            <textarea @bind="_input"
                      @bind:event="oninput"
                      @onkeydown="OnKeyDown"
                      rows="1"
                      placeholder="输入消息，Enter 发送，Shift+Enter 换行"></textarea>
            @if (Client.IsRunning)
            {
                <button class="stop" @onclick="Client.Stop">停止</button>
            }
            else
            {
                <button class="send" disabled="@(string.IsNullOrWhiteSpace(_input) || Client.IsSwitchingSession)" @onclick="SendAsync">发送</button>
            }
        </footer>
    </main>

    <ActivityPanel Activities="Client.Activities" ContextItems="Client.ContextItems" />
</div>

@code {
    private string _input = string.Empty;
    private string _workingDirectory = string.Empty;
    private string _theme = "light";
    private bool _navOpen;
    private bool _activityOpen;

    protected override async Task OnInitializedAsync()
    {
        _workingDirectory = Directory.GetCurrentDirectory();
        _theme = await Js.InvokeAsync<string>("app.getTheme");
        Client.Changed += OnClientChanged;
        await Client.InitializeAsync();
    }

    private void OnClientChanged() => _ = InvokeAsync(StateHasChanged);

    private void ToggleNav() => _navOpen = !_navOpen;

    private void ToggleActivity() => _activityOpen = !_activityOpen;

    private async Task ToggleThemeAsync()
    {
        await Js.InvokeVoidAsync("app.toggleTheme");
        _theme = await Js.InvokeAsync<string>("app.getTheme");
    }

    private async Task NewSessionAsync()
    {
        _navOpen = false;
        await Client.NewSessionAsync();
    }

    private async Task SendAsync()
    {
        var text = _input;
        if (string.IsNullOrWhiteSpace(text) || Client.IsRunning || Client.IsSwitchingSession)
            return;

        _input = string.Empty;
        await Client.SendAsync(text);
        await Js.InvokeVoidAsync("app.fitComposer");
    }

    private async Task OnKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !args.ShiftKey)
            await SendAsync();
    }

    private async Task SwitchSessionAsync(string conversationId)
    {
        if (Client.IsRunning || Client.IsSwitchingSession || Client.IsInitializing)
            return;

        _navOpen = false;

        // 点的就是当前会话：只需收起抽屉，不必重放一遍历史。
        if (string.Equals(conversationId, Client.ForegroundSessionId, StringComparison.Ordinal))
            return;

        await Client.SwitchSessionAsync(conversationId);
    }

    private Task RespondAsync(InteractionAnswer answer)
    {
        if (answer.Approval is { } approval)
            Client.RespondApproval(approval);
        else if (answer.Budget is { } budget)
            Client.RespondBudget(budget);
        else
            Client.RespondQuestion(answer.Text);

        return Task.CompletedTask;
    }

    public ValueTask DisposeAsync()
    {
        Client.Changed -= OnClientChanged;
        return ValueTask.CompletedTask;
    }
}
