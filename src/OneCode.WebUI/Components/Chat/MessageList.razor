@inject MarkdownRenderer Renderer
@inject IJSRuntime Js

<div class="messages">
    @if (HiddenCount > 0)
    {
        <button type="button" class="load-earlier" @onclick="LoadEarlier">
            加载更早的 @Math.Min(PageSize, HiddenCount) 条（还有 @HiddenCount 条）
        </button>
    }
    @for (var index = StartIndex; index < Messages.Count; index++)
    {
        var message = Messages[index];
        <div class="message-block @RoleClass(message.Role) @(message.IsStreaming ? "streaming" : "")">
            <article class="message @RoleClass(message.Role) @(message.IsStreaming ? "streaming" : "")">
                @if (message.Role == WebRole.System)
                {
                    <div class="system-line">@message.Content</div>
                }
                else if (message.Role == WebRole.User)
                {
                    @* 用户原文按纯文本呈现：走 Markdown 会把 HTML 源里的换行当成可见空白，还会改写用户输入。 *@
                    <div class="user-text">@message.Content</div>
                }
                else
                {
                    @if (!string.IsNullOrWhiteSpace(message.Thinking))
                    {
                        <details class="thinking">
                            <summary>思考过程</summary>
                            <pre>@message.Thinking</pre>
                        </details>
                    }
                    @if (string.IsNullOrEmpty(message.Content))
                    {
                        <div class="streaming-caret"></div>
                    }
                    else if (message.IsStreaming)
                    {
                        var (head, tail) = SplitStreamingTail(message.Content);
                        if (!string.IsNullOrEmpty(head))
                        {
                            <div class="markdown">@((MarkupString)Renderer.ToHtml(head))</div>
                        }
                        if (tail is not null)
                        {
                            <div class="stream-tail" @key="head.Length">@((MarkupString)Renderer.ToHtml(tail))</div>
                        }
                        <span class="streaming-caret inline"></span>
                    }
                    else
                    {
                        foreach (var part in Render(message).Parts)
                        {
                            if (part.Artifact is { } artifact)
                            {
                                <HtmlArtifactCard Source="@artifact" />
                            }
                            else if (part.Html is { } html)
                            {
                                <div class="markdown">@((MarkupString)html)</div>
                            }
                        }
                    }
                }
            </article>
            @* 操作按钮在气泡之外：气泡高度只由内容决定，不被悬停操作撑高。 *@
            @if (message.Role != WebRole.System && !string.IsNullOrEmpty(message.Content))
            {
                <div class="msg-actions">
                    <button type="button" class="msg-copy @(_copiedIndex == index ? "copied" : "")"
                            title="@(_copiedIndex == index ? "已复制" : "复制")"
                            @onclick="() => CopyMessageAsync(message, index)">
                        @if (_copiedIndex == index)
                        {
                            <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8.5l3.2 3.2L13 5"/></svg>
                        }
                        else
                        {
                            <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="5.5" y="5.5" width="8" height="8" rx="1.5"/><path d="M10.5 3.5h-7a1 1 0 0 0-1 1v7"/></svg>
                        }
                    </button>
                </div>
            }
        </div>
    }
</div>

@code {
    private const int PageSize = 20;

    [Parameter, EditorRequired]
    public IReadOnlyList<WebMessage> Messages { get; set; } = [];

    /// <summary>会话边界：变化即视为切换会话，分页窗口回到首屏。</summary>
    [Parameter]
    public string? SessionKey { get; set; }

    private int? _copiedIndex;
    private int _copyGeneration;
    private string? _sessionKey;
    private int _visible = PageSize;
    private int _lastCount;

    // 已完结消息的渲染结果：内容不变就复用，避免流式期间反复解析 + 消毒整条历史。
    private readonly Dictionary<WebMessage, RenderedMessage> _rendered = [];

    /// <summary>窗口起点：只渲染最近 <see cref="_visible"/> 条，更早的按页加载。</summary>
    private int StartIndex => Math.Max(0, Messages.Count - _visible);

    private int HiddenCount => StartIndex;

    private void LoadEarlier() => _visible += PageSize;

    protected override void OnParametersSet()
    {
        if (!string.Equals(_sessionKey, SessionKey, StringComparison.Ordinal))
        {
            _sessionKey = SessionKey;
            _visible = PageSize;
            _copiedIndex = null;
            _rendered.Clear();
        }
        else if (Messages.Count > _lastCount)
        {
            // 新消息到达时同步放大窗口，避免把已在屏上的旧消息挤出渲染窗口。
            _visible += Messages.Count - _lastCount;
        }

        _lastCount = Messages.Count;
    }

    private static string RoleClass(WebRole role) => role switch
    {
        WebRole.User => "user",
        WebRole.Assistant => "assistant",
        _ => "system",
    };

    /// <summary>
    /// 已完结助手的渲染：整页 HTML 产物抽成预览卡，其余按 Markdown 渲染（输出已消毒）。
    /// 结果按消息实例缓存，内容未变时直接复用。
    /// </summary>
    private RenderedMessage Render(WebMessage message)
    {
        if (_rendered.TryGetValue(message, out var cached) && cached.Content == message.Content)
            return cached;

        var parts = new List<RenderedPart>();
        foreach (var segment in HtmlArtifactSplitter.Split(message.Content))
        {
            if (segment.ArtifactHtml is { } artifact)
                parts.Add(new RenderedPart(Html: null, Artifact: artifact));
            else
                parts.Add(new RenderedPart(Html: Renderer.ToHtml(segment.Markdown), Artifact: null));
        }

        var rendered = new RenderedMessage(message.Content, parts);
        _rendered[message] = rendered;
        return rendered;
    }

    private sealed record RenderedMessage(string Content, IReadOnlyList<RenderedPart> Parts);

    private sealed record RenderedPart(string? Html, string? Artifact);

    /// <summary>
    /// 流式渲染拆分：已完结块走稳定渲染，最后一个未完成块独立成尾段，
    /// 由尾段容器（随块重建）承载「模糊→清晰」入场动效。
    /// 拆分点只取不在未闭合代码围栏内的空行之后，避免把代码块拦腰截断。
    /// </summary>
    private static (string Head, string? Tail) SplitStreamingTail(string content)
    {
        var safeSplit = -1;
        var inFence = false;
        var lineStart = 0;
        for (var i = 0; i <= content.Length; i++)
        {
            if (i < content.Length && content[i] != '\n')
                continue;

            var line = content[lineStart..i].TrimEnd('\r');
            if (line.StartsWith("```", StringComparison.Ordinal))
                inFence = !inFence;
            else if (!inFence && line.Length == 0 && lineStart > 0 && i + 1 < content.Length)
                safeSplit = i + 1;
            lineStart = i + 1;
        }

        if (safeSplit <= 0)
            return (string.Empty, content.Length == 0 ? null : content);

        var tail = content[safeSplit..];
        return string.IsNullOrWhiteSpace(tail) ? (content, null) : (content[..safeSplit], tail);
    }

    private async Task CopyMessageAsync(WebMessage message, int index)
    {
        if (_copiedIndex == index)
            return;

        var ok = await Js.InvokeAsync<bool>("app.copyText", message.Content);
        if (!ok)
            return;

        var generation = ++_copyGeneration;
        _copiedIndex = index;
        StateHasChanged();
        await Task.Delay(2500);
        if (generation != _copyGeneration)
            return;

        _copiedIndex = null;
        StateHasChanged();
    }
}
