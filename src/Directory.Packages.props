<Project>
  <!--
    Central Package Management for OneCode .NET
    See: https://learn.microsoft.com/en-us/nuget/consume-packages/central-package-management
    All package versions are pinned here. Project files declare PackageReference WITHOUT Version.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Microsoft Extensions (.NET 10)">
    <PackageVersion Include="Microsoft.Agents.AI.Tools.Shell" Version="1.15.0-preview.260722.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageVersion Include="OllamaSharp" Version="5.4.30" />
  </ItemGroup>
  <ItemGroup Label="System Libraries">
    <PackageVersion Include="System.CommandLine" Version="2.0.10" />
  </ItemGroup>
  <ItemGroup Label="API / Protocol">
    <PackageVersion Include="ModelContextProtocol" Version="2.1.0" />
  </ItemGroup>
  <ItemGroup Label="Terminal UI">
    <!--
      Terminal.Gui v2 is the sole TUI library for OneCode.NET.
      Instance-based IApplication model, built-in scrolling, 24-bit TrueColor,
      Scheme-based theming, and Command/KeyBindings input architecture.
    -->
    <PackageVersion Include="Terminal.Gui" Version="2.4.17" />
    <PackageVersion Include="Terminal.Gui.Editor" Version="2.5.7" />
    <PackageVersion Include="Markdig" Version="1.3.2" />
  </ItemGroup>
  <ItemGroup Label="AI / LLM Abstraction">
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.Abstractions" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.9.0" />
    <PackageVersion Include="Anthropic" Version="12.40.0" />
  </ItemGroup>
  <ItemGroup Label="Agent Framework">
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.18.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Workflows" Version="1.18.0" />
    <!--
      Workflows.Declarative 评估结论：
      该包要求 ResponseAgentProvider（Azure AI Foundry），与本地 IChatClient 架构不兼容。
      未来如需声明式 YAML 工作流，需实现自定义 ResponseAgentProvider 适配器。
      Microsoft.Agents.AI.Workflows 仍被 TeamOrchestrationService 使用（GroupChat/Magentic）。
    -->
    <!-- 1.15.0 配套版本：与 Microsoft.Agents.AI 1.15.0 对齐 -->
    <PackageVersion Include="Microsoft.Agents.AI.Mcp" Version="1.15.0-alpha.260722.1" />
    <PackageVersion Include="Microsoft.Agents.AI.Hyperlight" Version="1.15.0-preview.260722.1" />
    <PackageVersion Include="Hyperlight.HyperlightSandbox.Api" Version="0.5.0" />
    <PackageVersion Include="Hyperlight.HyperlightSandbox.Guest.Python" Version="0.5.0" />
  </ItemGroup>
  <ItemGroup Label="Tooling">
    <PackageVersion Include="Cronos" Version="0.13.0" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <!-- SSH.NET: 2026.0.0 修复 GHSA-q939-rpr3-3284 / CVE-2026-48798（ScpClient 递归下载路径遍历，<=2025.1.0 受影响）。
         OneCode 仅用 SshClient/SftpClient，未用 ScpClient；升级消除 NU1903 构建阻塞。 -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="CliWrap" Version="3.10.4" />
    <!-- AngleSharp: HTML DOM 解析，用于 WebFetchTool.HtmlToMarkdown 替代正则解析。
         纯托管、零传递依赖。
         版本 1.5.2：修复 1.3.0 的 GHSA-pgww-w46g-26qg（中等严重性）漏洞。 -->
    <PackageVersion Include="AngleSharp" Version="1.7.1" />
    <PackageVersion Include="SkiaSharp" Version="4.151.1" />
    <PackageVersion Include="System.ClientModel" Version="1.14.0" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="FluentAssertions" Version="8.10.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>